# Copy to .env.local. Names only: never commit real values.

# Supabase project (bloat-test for previews). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Its SHA-256 hash is stored in the database (private.server_secrets).
BLOAT_SERVER_SECRET=

# AI provider: "mock" (labelled mock, default) or "anthropic".
BLOAT_AI_PROVIDER=mock
BLOAT_AI_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# Billing: "mock" only. Real checkout stays off until Gate 2.
BLOAT_BILLING_PROVIDER=mock
BLOAT_BILLING_WEBHOOK_SECRET=

# Founder tools (/admin). Empty = founder tools are off.
BLOAT_STAFF_EMAILS=

# Test sign-in with a password (synthetic accounts only). Never set on a live site.
BLOAT_TEST_LOGIN=0

# Optional: founder alert email through Resend. Empty = alerts stay in the database outbox.
RESEND_API_KEY=
BLOAT_FOUNDER_EMAIL=
