# Copy to .env.local. Names only: never commit real values.

# Supabase project (bloat-test for previews). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Its SHA-256 hash is stored in the database (private.server_secrets).
BLOAT_SERVER_SECRET=

# AI provider: "mock" (labelled mock, default), "off" (no AI anywhere) or "anthropic".
BLOAT_AI_PROVIDER=mock
# Feature keys not offered to anyone, comma-separated (for example learn_library,daily_cards). Empty: nothing off.
BLOAT_OFF_FEATURES=
BLOAT_AI_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# Billing: "mock" only. Real checkout stays off until Gate 2.
BLOAT_BILLING_PROVIDER=mock
BLOAT_BILLING_WEBHOOK_SECRET=

# Founder tools (/admin). Empty = founder tools are off.
BLOAT_STAFF_EMAILS=

# Test sign-in with a password (synthetic accounts only). Never set on a live site.
BLOAT_TEST_LOGIN=0

# Optional: founder alert email through Resend. Empty = alerts stay in the database outbox.
RESEND_API_KEY=
BLOAT_FOUNDER_EMAIL=

# Test accounts that get Pro without a purchase (confirmed addresses only). Empty on a live site.
BLOAT_PRO_TEST_EMAILS=

# Sign-in shown by the app: email_code (default, real users) or password (owner-provisioned test
# accounts only, with sign-ups switched off in Supabase). See DEPLOYMENT.md, "Sign-in method".
BLOAT_SIGN_IN_METHOD=
