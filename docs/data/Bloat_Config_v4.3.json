  "metrics": {
    "primary_outcome": "CONFIRMED_DAILY_WORST_0_10",
    "metric_version": "daily_worst_v1",
    "bloat_score_label": "Bloat Score = confirmed worst bloating for a completed day, 0-10",
    "today_label": "Highest logged so far",
    "duration": "SEPARATE_REPORTED_INTERVALS; no imputation; no cap in source records",
    "recall_policy": "Timely if entered by end of the following analysis-zone local date; later = LATE (history only).",
    "seven_day_average": {
      "window_dates": 7,
      "min_usable_dates": 4,
      "includes": [
        "CONFIRMED",
        "LATE"
      ],
      "excludes": [
        "UNKNOWN",
        "PROVISIONAL",
        "CONFLICT",
        "partial"
      ]
    },
    "comparison_group_display_minimum": 7,
    "comparison_states": [
      "PAUSED",
      "NEEDS_CORRECTION",
      "NO_ELIGIBLE_DATA",
      "ONE_GROUP_ONLY",
      "SPARSE",
      "DESCRIPTIVE_COMPARISON"
    ],
    "food_coverage_rule": "Full coverage required on both exposed and unexposed days.",
    "ingredient_evidence_accepted": [
      "label",
      "known_recipe",
      "user_known"
    ],
    "ingredient_evidence_excluded": [
      "accepted_guess",
      "unknown"
    ]
  },
  "ai": {
    "input_max_chars": 300,
    "output_max_ingredients": 20,
    "max_retries": 1,
    "timeout_ms": "configurable",
    "per_user_daily_quota": "configurable",
    "never_send": [
      "symptoms",
      "scores",
      "conditions",
      "pregnancy",
      "identity",
      "country",
      "history",
      "age range",
      "ovaries",
      "cycle or menopause",
      "family history",
      "medicines"
    ],
    "failure": "abstain -> manual entry with unknown ingredients",
    "slice_a_adapter": "mock (labelled as mock)",
    "purposes": [
      "DISH_RECOGNITION_FROM_PHOTO",
      "FOOD_GROUP_INGREDIENT_LIST"
    ],
    "model": "claude-haiku-5-5",
    "photo": {
      "max_side_px": 1000,
      "strip_metadata": true,
      "delete_after_check_default": true
    },
    "no_calories": true,
    "provider_layer": "fixed input/output schema; provider and model set in configuration",
    "source_labels": [
      "seen_in_photo",
      "usually_in_recipe"
    ]
  },
  "personal_focus": [
    {
      "id": "P1",
      "trigger": "ON-04 / ON-05",
      "effect": "Order suggestions by cuisine"
    },
    {
      "id": "P2",
      "trigger": "Constipation, no bowel movement or diarrhoea on >=3 of last 14 completed dates",
      "effect": "Suggest bowel tracking (Pro bowel log); no alert"
    },
    {
      "id": "P3",
      "trigger": "Gas or burping on >=3 of last 14 dates",
      "effect": "Suggest tracking eating speed, straws, gum, fizzy drinks"
    },
    {
      "id": "P4",
      "trigger": "Heartburn in last 14 dates, or >=5 starts with over half after 18:00",
      "effect": "Suggest logging meal and sleep times"
    },
    {
      "id": "P5",
      "trigger": "EP-04 suspicion",
      "effect": "Offer as a possible-trigger check labelled Your suspicion"
    },
    {
      "id": "P6",
      "trigger": ">=10 ended episodes with known start",
      "effect": "Hour-of-day and weekday chart"
    },
    {
      "id": "P7",
      "trigger": "ON-10 cycle opt-in and CY-01/CY-02 dates, or perimenopause/menopause",
      "effect": "Shade cycle or menopause context; Your cycle comparison after 3 cycles"
    }
  ],
  "personal_focus_behaviour": {
    "dismiss_days": 30,
    "reoffer_times_after_dismiss": 1,
    "rolling_rules_removed_when_no_longer_met": true,
    "safety_hold_suppresses": [
      "P2",
      "P3",
      "P4",
      "comparisons"
    ]
  },
